# Postgres connection string (Neon-hosted in production).
DATABASE_URL="postgresql://user:password@localhost:5432/dealership?schema=public"

# Optional Redis instance — not used yet, reserved for queues/rate limiting.
REDIS_URL=""

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the web app (used by Auth.js for callback/canonical URLs).
AUTH_URL="http://localhost:3000"

# OAuth — Google. If unset, the Google button on /sign-in renders but
# shows "Provider not configured" on click.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OAuth — Apple. Apple uses a JWT-based client secret that we generate
# at runtime from these four values; if any is missing the button is
# inactive. AUTH_APPLE_KEY is the .p8 file contents (PEM, with literal
# \n newlines).
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_KEY=""

# Resend transactional email — key only, no sends wired up yet.
RESEND_API_KEY=""

# SMTP transport (used by financing emails). If any of SMTP_HOST/SMTP_PORT/
# MAIL_FROM are missing, the mailer logs payloads instead of sending — local
# dev still works.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
# Set to "true" to force TLS on non-465 ports.
SMTP_SECURE=""
MAIL_FROM=""

# Where new financing-application notifications are sent. If unset, the admin
# notification is skipped (the applicant confirmation still goes out).
ADMIN_NOTIFY_EMAIL=""

# Cloudflare R2 (S3-compatible) for image/asset storage.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""

# Public base URL of the Fastify API consumed by the Next.js app.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Fastify port override (defaults to 4000 if unset).
PORT="4000"
