# Postgres connection string (Neon-hosted in production). The default matches
# `docker compose up -d` (see docker-compose.yml).
DATABASE_URL="postgresql://dealership:dealership@localhost:5433/dealership?schema=public"

# Optional Redis instance — not used yet, reserved for queues/rate limiting.
REDIS_URL=""

# Auth.js v5 — REQUIRED for sign-in. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the web app (used by Auth.js, CORS on the API, and as the
# fallback canonical URL for metadata/sitemap).
AUTH_URL="http://localhost:3000"

# Canonical public site URL for SEO (sitemap, Open Graph). Optional — falls
# back to AUTH_URL.
NEXT_PUBLIC_SITE_URL=""

# Resend transactional email — key only, no sends wired up yet.
RESEND_API_KEY=""

# SMTP transport (used by financing emails). If any of SMTP_HOST/SMTP_PORT/
# MAIL_FROM are missing, the mailer logs payloads instead of sending — local
# dev still works.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
# Set to "true" to force TLS on non-465 ports.
SMTP_SECURE=""
MAIL_FROM=""

# Where staff notifications (new test drives, trade-ins, financing
# applications) are sent. If unset, staff notifications are skipped; customer
# confirmations still go out.
ADMIN_NOTIFY_EMAIL=""

# Cloudflare R2 (S3-compatible) for image/asset storage.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""

# Public base URL of the Fastify API consumed by the Next.js app.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Fastify port override (defaults to 4000 if unset).
PORT="4000"

# Optional overrides for the demo accounts created by `pnpm db:seed`
# (defaults are documented in the README — change them on shared databases).
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""
