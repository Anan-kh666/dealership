{
  "name": "dealership",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @dealership/db db:generate",
    "db:migrate:dev": "pnpm --filter @dealership/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @dealership/db db:migrate:deploy",
    "db:studio": "pnpm --filter @dealership/db db:studio",
    "db:seed": "pnpm --filter @dealership/db db:seed && pnpm --filter @dealership/vehicles sync:seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:up": "docker compose up -d --wait",
    "db:setup": "pnpm db:up && pnpm db:generate && pnpm db:migrate:deploy && pnpm db:seed",
    "vehicles:sync": "pnpm --filter @dealership/vehicles sync",
    "vehicles:check": "pnpm --filter @dealership/vehicles check"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
