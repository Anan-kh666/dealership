generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ MODELS / TRIMS / OPTIONS ============

model Model {
  id              String       @id @default(cuid())
  slug            String       @unique
  make            String
  name            String
  year            Int
  bodyType        BodyType
  description     String
  startingPrice   Decimal      @db.Decimal(12, 2)
  currency        String       @default("MYR")
  heroImage       String
  brochureUrl     String?
  isActive        Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  displayOrder    Int          @default(0)
  highlights      String[]
  metaTitle       String?
  metaDescription String?
  trims           Trim[]
  images          ModelImage[]
  inquiries       Inquiry[]
  testDrives      TestDrive[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([make, slug])
  @@index([isActive, isFeatured])
}

model Trim {
  id              String          @id @default(cuid())
  modelId         String
  model           Model           @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name            String
  price           Decimal         @db.Decimal(12, 2)
  engineSize      Float?
  horsepower      Int?
  torque          Int?
  transmission    Transmission
  fuelType        FuelType
  drivetrain      Drivetrain
  fuelEconomy     Float?
  zeroToHundred   Float?
  topSpeed        Int?
  seats           Int
  doors           Int
  cargoCapacity   Int?
  features        String[]
  displayOrder    Int             @default(0)
  options         OptionOnTrim[]
  trimColors      TrimColor[]
  configurations  Configuration[]
  stockUnits      StockUnit[]

  @@unique([modelId, name])
}

model Option {
  id          String         @id @default(cuid())
  name        String
  description String?
  category    OptionCategory
  price       Decimal        @db.Decimal(10, 2)
  image       String?
  trims       OptionOnTrim[]
}

model OptionOnTrim {
  trimId     String
  optionId   String
  trim       Trim    @relation(fields: [trimId], references: [id], onDelete: Cascade)
  option     Option  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  isStandard Boolean @default(false)

  @@id([trimId, optionId])
}

model Color {
  id         String      @id @default(cuid())
  name       String
  hexCode    String
  type       ColorType
  isMetallic Boolean     @default(false)
  trimColors TrimColor[]
}

model TrimColor {
  trimId   String
  colorId  String
  trim     Trim    @relation(fields: [trimId], references: [id], onDelete: Cascade)
  color    Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)
  upcharge Decimal @default(0) @db.Decimal(10, 2)

  @@id([trimId, colorId])
}

model ModelImage {
  id      String    @id @default(cuid())
  modelId String
  model   Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  url     String
  altText String?
  type    ImageType
  order   Int
}

// ============ CONFIGURATIONS / STOCK ============

model Configuration {
  id              String               @id @default(cuid())
  shareCode       String               @unique
  trimId          String
  trim            Trim                 @relation(fields: [trimId], references: [id])
  exteriorColorId String
  interiorColorId String
  selectedOptions String[]
  totalPrice      Decimal              @db.Decimal(12, 2)
  userId          String?
  user            User?                @relation(fields: [userId], references: [id])
  guestEmail      String?
  inquiries       Inquiry[]
  applications    FinanceApplication[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model StockUnit {
  id               String               @id @default(cuid())
  vin              String               @unique
  slug             String               @unique
  trimId           String
  trim             Trim                 @relation(fields: [trimId], references: [id])
  exteriorColorId  String
  interiorColorId  String
  installedOptions String[]
  totalPrice       Decimal              @db.Decimal(12, 2)
  status           StockStatus          @default(AVAILABLE)
  arrivalDate      DateTime?
  expectedDelivery DateTime?
  daysOnLot        Int                  @default(0)
  views            Int                  @default(0)
  reservedById     String?
  images           StockImage[]
  testDrives       TestDrive[]
  inquiries        Inquiry[]
  applications     FinanceApplication[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([trimId, status])
}

model StockImage {
  id          String    @id @default(cuid())
  stockUnitId String
  stockUnit   StockUnit @relation(fields: [stockUnitId], references: [id], onDelete: Cascade)
  url         String
  altText     String?
  order       Int
}

// ============ USERS & LEADS ============

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  phone          String?
  name           String
  passwordHash   String?
  role           Role                 @default(CUSTOMER)
  configurations Configuration[]
  testDrives     TestDrive[]
  applications   FinanceApplication[]
  tradeIns       TradeIn[]
  createdAt      DateTime             @default(now())
}

model TestDrive {
  id          String          @id @default(cuid())
  modelId     String?
  model       Model?          @relation(fields: [modelId], references: [id])
  stockUnitId String?
  stockUnit   StockUnit?      @relation(fields: [stockUnitId], references: [id])
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  drivingLicense  String?
  scheduledAt     DateTime
  status          TestDriveStatus @default(REQUESTED)
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([scheduledAt])
}

model FinanceApplication {
  id                 String         @id @default(cuid())
  referenceNumber    String         @unique
  configurationId    String?
  configuration      Configuration? @relation(fields: [configurationId], references: [id])
  stockUnitId        String?
  stockUnit          StockUnit?     @relation(fields: [stockUnitId], references: [id])
  userId             String?
  user               User?          @relation(fields: [userId], references: [id])

  // Vehicle context (free-text label captured at submit so we can show it back
  // to the customer even if the linked stock unit is later sold/removed).
  vehicleLabel       String?
  vehiclePrice       Decimal        @db.Decimal(12, 2)

  // Loan terms
  loanAmount         Decimal        @db.Decimal(12, 2)
  downPayment        Decimal        @db.Decimal(12, 2)
  downPaymentPercent Decimal        @db.Decimal(5, 2)
  tenureYears        Int
  termMonths         Int
  interestRatePct    Decimal        @db.Decimal(5, 2)
  estimatedMonthly   Decimal        @db.Decimal(12, 2)

  // Personal — applicantName/email/phone are kept on the original schema for
  // backward-compat ("phone" is the mobile number).
  applicantName      String
  email              String
  phone              String
  icNumber           String
  dateOfBirth        DateTime
  nationality        String
  maritalStatus      String
  addressStreet      String
  addressCity        String
  addressState       String
  addressPostcode    String

  // Employment & income
  employmentType     String
  employerName       String
  position           String
  monthlyIncome      Decimal        @db.Decimal(12, 2)
  monthlyCommitments Decimal?       @db.Decimal(12, 2)
  yearsEmployed      Decimal        @db.Decimal(5, 2)

  // Documents — uploaded via R2 presign; nullable so the step is skippable.
  icFrontUrl         String?
  icBackUrl          String?
  payslipUrls        String[]
  bankStatementUrls  String[]
  documentsSkipped   Boolean        @default(false)

  status             AppStatus      @default(SUBMITTED)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, createdAt])
}

model TradeIn {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  vin            String?
  make           String
  model          String
  year           Int
  mileage        Int
  condition      String
  photos         String[]
  estimatedValue Decimal?      @db.Decimal(12, 2)
  status         TradeInStatus @default(SUBMITTED)
  notes          String?
  contactName    String
  contactEmail   String
  contactPhone   String
  createdAt      DateTime      @default(now())
}

model Inquiry {
  id              String         @id @default(cuid())
  modelId         String?
  model           Model?         @relation(fields: [modelId], references: [id])
  stockUnitId     String?
  stockUnit       StockUnit?     @relation(fields: [stockUnitId], references: [id])
  configurationId String?
  configuration   Configuration? @relation(fields: [configurationId], references: [id])
  name            String
  email           String
  phone           String?
  message         String
  source          String?
  status          InquiryStatus  @default(NEW)
  createdAt       DateTime       @default(now())
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  content         String
  coverImage      String
  authorName      String
  publishedAt     DateTime?
  tags            String[]
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============ ENUMS ============

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  COUPE
  CONVERTIBLE
  TRUCK
  VAN
  WAGON
}

enum Transmission {
  AUTOMATIC
  MANUAL
  CVT
  DCT
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
}

enum Drivetrain {
  FWD
  RWD
  AWD
  FOUR_WD
}

enum OptionCategory {
  SAFETY
  COMFORT
  TECH
  PERFORMANCE
  EXTERIOR
  INTERIOR
}

enum ColorType {
  EXTERIOR
  INTERIOR
}

enum ImageType {
  EXTERIOR
  INTERIOR
  DETAIL
  LIFESTYLE
}

enum StockStatus {
  AVAILABLE
  RESERVED
  SOLD
  IN_TRANSIT
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum TestDriveStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum AppStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum TradeInStatus {
  SUBMITTED
  REVIEWING
  QUOTED
  ACCEPTED
  REJECTED
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}
