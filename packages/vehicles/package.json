{
  "name": "@dealership/vehicles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Turns the folders in /models into catalogue rows and configurator 3D assets.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsx src/cli.ts assets",
    "dev": "dotenv -e ../../.env -- tsx src/cli.ts sync --watch",
    "sync": "dotenv -e ../../.env -- tsx src/cli.ts sync",
    "sync:seed": "dotenv -e ../../.env -- tsx src/cli.ts sync --reset-stock",
    "check": "tsx src/cli.ts check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@dealership/db": "workspace:*",
    "@dealership/types": "workspace:*",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@dealership/config": "workspace:*",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
